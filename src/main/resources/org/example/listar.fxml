      <Button fx:id="regresar" alignment="CENTER" layoutX="478.0" layoutY="345.0" mnemonicParsing="false" onAction="#regresarAInicio" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #2B2B2B; -fx-background-radius: 8;" textFill="WHITE" text="Regresar" textAlignment="CENTER">
