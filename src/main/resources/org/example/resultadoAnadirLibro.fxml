                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="regresar" alignment="CENTER" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #111111;" text="Regresar" textFill="WHITE" HBox.hgrow="ALWAYS">
