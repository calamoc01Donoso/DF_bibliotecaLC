      </Button>
      <Button fx:id="modificar" alignment="CENTER" layoutX="179.0" layoutY="345.0" mnemonicParsing="false" onAction="#irAModificar" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #C6A85B; -fx-background-radius: 8;" textFill="WHITE" text="Modificar" textAlignment="CENTER">
