      <Button fx:id="eliminar" alignment="CENTER" layoutX="331.0" layoutY="345.0" mnemonicParsing="false" onAction="#irAEliminar" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #B95C5C; -fx-background-radius: 8;" textFill="WHITE" text="Eliminar" textAlignment="CENTER">
