<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AnadirLibroController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="NUEVO LIBRO">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="149.3999786376953" minWidth="10.0" prefWidth="92.86660766601562" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="225.13339233398435" minWidth="10.0" prefWidth="225.13339233398435" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Autor" />
            <Label text="Título" GridPane.rowIndex="1" />
            <Label text="Género" GridPane.rowIndex="2" />
            <Label text="ISBN" GridPane.rowIndex="3" />
            <Label text="Fecha Salida" GridPane.rowIndex="4" />
            <Label text="Portada" GridPane.rowIndex="5" />
            <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="120.0" text="Adjuntar imagen" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <Label text="Leo y Celia" GridPane.columnIndex="1" />
            <Label text="El mapa de lo desconocido" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Aventura" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="95974SL98" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="04 de Septiembre de 2025" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
         <VBox.margin>
            <Insets left="15.0" />
         </VBox.margin>
         <padding>
            <Insets right="10.0" />
         </padding>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="50.0">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <children>
            <Button alignment="CENTER" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #AEEA00;" text="Añadir">
