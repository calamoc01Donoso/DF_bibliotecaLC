<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextArea?>

<Pane prefHeight="450.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.BibliotecaControlador">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="404.0" prefWidth="640.0" spacing="4.0">
          <padding>
              <Insets bottom="5.0" left="20.0" right="20.0" top="10.0" />
          </padding>
         <children>
             <Label text="NUEVO LIBRO"
                    textFill="#34452F">
                 <font>
                     <Font name="System Bold" size="24.0" />
                 </font>
             </Label>
            <GridPane hgap="10.0" prefHeight="270.0" prefWidth="545.0" vgap="3.0" style="-fx-background-color: #F3F1E8;
       -fx-background-radius: 15;
       -fx-border-color: #A8AD8E;
       -fx-border-radius: 15;
       -fx-border-width: 1;">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="149.3999786376953" minWidth="10.0" prefWidth="92.86660766601562" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="225.13339233398435" minWidth="10.0" prefWidth="225.13339233398435" />
              </columnConstraints>
              <rowConstraints>
                  <RowConstraints minHeight="33.0" prefHeight="33.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="33.0" prefHeight="33.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="33.0" prefHeight="33.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="33.0" prefHeight="33.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="33.0" prefHeight="33.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="62.0" prefHeight="62.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="38.0" prefHeight="38.0" vgrow="SOMETIMES" />
              </rowConstraints>
                <children>
                    <!-- AUTOR -->
                    <Label text="Autor"
                           GridPane.rowIndex="0" />

                    <TextField fx:id="autor"
                               prefWidth="350.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0" />

                    <!-- TÍTULO -->
                    <Label text="Título"
                           GridPane.rowIndex="1" />

                    <TextField fx:id="titulo"
                               prefWidth="350.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                    <!-- GÉNERO -->
                    <Label text="Género"
                           GridPane.rowIndex="2" />

                    <TextField fx:id="genero"
                               prefWidth="350.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2" />

                    <!-- ISBN -->
                    <Label text="ISBN"
                           GridPane.rowIndex="3" />

                    <TextField fx:id="isbn"
                               prefWidth="350.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3" />

                    <!-- FECHA -->
                    <Label text="Fecha Salida"
                           GridPane.rowIndex="4" />

                    <TextField fx:id="fsalida"
                               prefWidth="350.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="4" />

                    <!-- DESCRIPCIÓN -->
                    <Label text="Descripción"
                           GridPane.rowIndex="5" />

                    <TextArea fx:id="descripcion"
                               prefHeight="60.0"
                               prefWidth="350.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="5" />

                    <!-- PORTADA -->
                    <Label text="Portada"
                           GridPane.rowIndex="6" />

                    <Button fx:id="imagen"
                            mnemonicParsing="false"
                            onAction="#seleccionarPortada"
                            prefHeight="40.0"
                            prefWidth="120.0"
                            text="Adjuntar imagen"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="6" />

                </children>
               <VBox.margin>
                  <Insets left="15.0" />
               </VBox.margin>
                <padding>
                    <Insets bottom="15.0"
                            left="20.0"
                            right="20.0"
                            top="15.0" />
                </padding>
            </GridPane>
            <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="50.0">
                <VBox.margin>
                    <Insets bottom="15.0" />
                </VBox.margin>
               <children>
                  <Button alignment="CENTER" mnemonicParsing="false" onAction="#agregarLibro" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #66734E; -fx-background-radius: 8;" text="Añadir" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  <Button alignment="CENTER" mnemonicParsing="false" onAction="#regresarAInicio" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #2B2B2B; -fx-background-radius: 8;" text="Regresar" textFill="WHITE" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font>
                      <HBox.margin>
                          <Insets left="8.0" />
                      </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
       <Pane layoutX="0.0"
             layoutY="404.0"
             prefHeight="46.0"
             prefWidth="640.0"
             style="-fx-background-color: #000000;">

           <children>

               <Label alignment="CENTER"
                      layoutX="0.0"
                      layoutY="0.0"
                      prefHeight="46.0"
                      prefWidth="640.0"
                      text="COPYRIGHT: ©Celia Álamo Calle y Leonarda Ivette Martínez García"
                      textAlignment="CENTER"
                      textFill="WHITE">

                   <font>
                       <Font size="15.0" />
                   </font>

               </Label>

           </children>

       </Pane>

   </children>

</Pane>