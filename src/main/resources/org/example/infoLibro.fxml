<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.TextArea?>


<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.BibliotecaControlador">
   <children>
      <TextField fx:id="inpubuscar" layoutX="34.0" layoutY="25.0" prefHeight="25.0" prefWidth="459.0" />
      <Button fx:id="btbuscar" layoutX="503.0" layoutY="25.0" mnemonicParsing="false" onAction="#buscarLibroInfo" prefHeight="25.0" prefWidth="76.0" text="Buscar" />
      <ImageView fx:id="portadaInfo" fitHeight="260.0" fitWidth="190.0" layoutX="390.0" layoutY="80.0" pickOnBounds="true" preserveRatio="true" />

       <!-- Título -->
       <Label layoutX="42.0" layoutY="78.0" prefHeight="17.0" prefWidth="50.0" text="Título" />
       <Label fx:id="title" layoutX="110.0" layoutY="78.0" prefHeight="17.0" prefWidth="250.0" text="dsd" />

       <!-- Autor -->
       <Label layoutX="42.0" layoutY="114.0" prefHeight="17.0" prefWidth="50.0" text="Autor" />
       <Label fx:id="autorInfo" layoutX="110.0" layoutY="114.0" prefHeight="17.0" prefWidth="250.0" text="dsd" />

       <!-- ISBN -->
       <Label layoutX="42.0" layoutY="150.0" prefHeight="17.0" prefWidth="50.0" text="ISBN" />
       <Label fx:id="isbnInfo" layoutX="110.0" layoutY="150.0" prefHeight="17.0" prefWidth="250.0" text="dsd" />

       <!-- Fecha de publicación -->
       <Label layoutX="42.0" layoutY="186.0" prefHeight="17.0" prefWidth="135.0" text="Fecha de publicación:" />
       <Label fx:id="fechaInfo" layoutX="185.0" layoutY="186.0" prefHeight="17.0" prefWidth="175.0" text="dsd" />

       <!-- Descripción -->
       <Label layoutX="42.0" layoutY="220.0" prefHeight="17.0" prefWidth="100.0" text="Descripción" />
       <TextArea fx:id="descripInfo" editable="false" focusTraversable="false" layoutX="42.0" layoutY="242.0" prefHeight="120.0" prefWidth="320.0" wrapText="true" />

       <!-- Botones -->
       <Button fx:id="btanadir" layoutX="42.0" layoutY="390.0" mnemonicParsing="false" onAction="#irAAnadir" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #66734E; -fx-background-radius: 8;" text="Añadir" textFill="WHITE" />
      <Button fx:id="btmodificar" layoutX="195.0" layoutY="390.0" mnemonicParsing="false" onAction="#modificarDesdeInfo" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #C6A85B; -fx-background-radius: 8;" text="Modificar" />
      <Button fx:id="bteliminar" layoutX="350.0" layoutY="390.0" mnemonicParsing="false" onAction="#eliminarDesdeInfo" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #B95C5C; -fx-background-radius: 8;" text="Eliminar" textFill="WHITE" />
       <Button fx:id="btregresar" layoutX="505.0" layoutY="390.0" mnemonicParsing="false" onAction="#regresarALista" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #2B2B2B; -fx-background-radius: 8;" text="Regresar" textFill="WHITE" />
   </children>
</Pane>
