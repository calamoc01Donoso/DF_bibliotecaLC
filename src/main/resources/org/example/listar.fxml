       </Label>
      <TextField fx:id="buscarId" alignment="CENTER" layoutX="100.0" layoutY="65.0" prefHeight="30.0" prefWidth="400.0" promptText="Buscar libro..." />
      <Button alignment="CENTER" layoutX="500.0" layoutY="65.0" mnemonicParsing="false" onAction="#buscarLibro" prefHeight="30.0" prefWidth="35.0" text="🔍" />

       <!-- Tarjeta que agrupa la tabla y la portada -->
       <Pane layoutX="25.0"
             layoutY="105.0"
             prefHeight="220.0"
             prefWidth="590.0"
             style="-fx-background-color: #F3F1E8;
             -fx-background-radius: 15;
             -fx-border-color: #A8AD8E;
             -fx-border-radius: 15;
             -fx-border-width: 1;" />
       <!-- Fin Tarjeta -->

       <Pane layoutX="0.0"
             layoutY="404.0"
             prefHeight="46.0"
             prefWidth="640.0"
             style="-fx-background-color: #000000;">

           <children>
               <Label alignment="CENTER"
                      layoutX="0.0"
                      layoutY="0.0"
                      prefHeight="46.0"
                      prefWidth="640.0"
                      text="COPYRIGHT: Celia Álamo Calle y Leonarda Ivette Martínez García"
                      textAlignment="CENTER"
                      textFill="WHITE">
                   <font>
                       <Font size="15.0" />
                   </font>
               </Label>
           </children>

       </Pane>

       <TableView fx:id="listatab" layoutX="37.0" layoutY="115.0"
                  prefHeight="200.0" prefWidth="352.0">
           <columns>

               <TableColumn fx:id="colId"
                            prefWidth="75.0"
                            text="ID" />

               <TableColumn fx:id="colTitulo"
                            prefWidth="75.0"
                            text="Titulo" />

               <TableColumn fx:id="colDescripcion"
                            prefWidth="110.39996337890625"
                            text="Descripcion" />

               <TableColumn fx:id="colAutor"
                            prefWidth="91.20001220703125"
                            text="Autor" />

           </columns>
       </TableView>
       <ImageView fx:id="portadaLista"
                  fitHeight="200.0"
                  fitWidth="146.0"
                  layoutX="442.0"
                  layoutY="115.0"
                  pickOnBounds="true"
                  preserveRatio="true" />

       <Button fx:id="añadir" onAction="#irAAnadir" alignment="CENTER" layoutX="43.0" layoutY="345.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #66734E; -fx-background-radius: 8;" textFill="WHITE" text="Añadir" textAlignment="CENTER">
         <font>
            <Font size="14.0" />
